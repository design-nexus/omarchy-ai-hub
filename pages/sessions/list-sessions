ID_PATTERNS = {
    "claude":   r"^[0-9a-fA-F-]{8,64}$",
    "codex":    r"^[0-9a-fA-F-]{8,64}$",
    "opencode": r"^[A-Za-z0-9_-]{4,80}$",
    "copilot":  r"^[A-Za-z0-9._-]{1,120}$",
    "gemini":   r"^[A-Za-z0-9._-]{1,120}$",
    "grok":     r"^[0-9a-fA-F-]{8,64}$",
}


def valid_id(agent, sid):
    if agent == "pi":  # pi ids are transcript paths; require a real file inside its store
        real = os.path.realpath(str(sid))
        store = os.path.realpath(HOME + "/.pi/agent/sessions") + os.sep
        if not real.startswith(store):
            return False
        try:
            return stat.S_ISREG(os.lstat(real).st_mode)
        except OSError:
            return False
    return re.match(ID_PATTERNS.get(agent, r"$^"), str(sid)) is not None


def find(agent, sid):
    for s in collect()["sessions"]:
        if s["agent"] == agent and s["id"] == sid:
            return s
    return None


def spawn(argv):
    subprocess.Popen(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def open_terminal(script):
    spawn(["setsid", "uwsm-app", "--", "xdg-terminal-exec", "-e",
           "bash", "-lc", script])


def shq(text):
    return "'" + str(text).replace("'", "'\\''") + "'"


def resume(agent, sid):
    s = find(agent, sid)
    if s is None:
        return
    cwd = s["dir"] if os.path.isdir(s["dir"]) else HOME
    inner = {
        "claude":   "claude --resume " + shq(sid),
        "codex":    "codex resume " + shq(sid),
        "opencode": "opencode --session " + shq(sid),
        "copilot":  "copilot --resume " + shq(sid),
        "pi":       "pi --session " + shq(sid),
        "gemini":   "gemini --resume " + shq(sid),
        "grok":     "grok --resume " + shq(sid),
    }[agent]
    open_terminal("cd " + shq(cwd) + " && " + inner +
                  "; ec=$?; if [ $ec -ne 0 ]; then echo; "
                  "read -n1 -p '[session-browser] exited with '$ec' — press any key'; fi")


def session_files(agent, sid, budget=None):
    budget = ensure_budget(budget)
    if agent == "claude":
        patterns = [(HOME + "/.claude/projects/*/" + sid + ".jsonl", False)]
    elif agent == "codex":
        patterns = [(HOME + "/.codex/sessions/*/*/*/rollout-*" + sid + ".jsonl", False)]
    elif agent == "grok":
        patterns = [(grok_home() + "/sessions/*/" + sid + "/chat_history.jsonl", False)]
    else:
        patterns = []
    return [path for path, _info in bounded_paths(patterns, budget, cap=8)]


def peek(agent, sid):
    me = os.path.abspath(__file__)
    open_terminal("python3 " + shq(me) + " peek-render " + shq(agent) + " "
                  + shq(sid) + " | less -R +G")


BOLD, DIM, RESET = "\033[1m", "\033[2m", "\033[0m"
_blocks_left = [400]  # hard cap on rendered conversation blocks


def render_block(role, text, limit=1500):
    if _blocks_left[0] <= 0:
        return
    _blocks_left[0] -= 1
    text = CTRL_RE.sub("", str(text)).strip()
    if not text:
        return
    if len(text) > limit:
        text = text[:limit] + " …[truncated]"
    safe_role = clean_inline(role, 24) or "assistant"
    label = BOLD + ("● You" if safe_role == "user"
                    else "○ " + safe_role.capitalize()) + RESET
    print(label + "\n" + text + "\n")


def peek_render(agent, sid):
    s = find(agent, sid)
    if s:
        print(DIM + s["agentName"] + " · " + s["dirShort"] + " · " + s["meta"] + RESET + "\n")
    budget = ScanBudget(seconds=3.0, max_paths=64, max_open_files=64,
                        max_bytes=MAX_SCAN_BYTES)
    deadline_state = arm_deadline(budget)
    try:
        render_transcript(agent, sid, budget)
    except ScanDeadline:
        print(DIM + "Preview stopped at the 3-second safety limit." + RESET)
    finally:
        restore_deadline(deadline_state)


def render_transcript(agent, sid, budget):
    if agent == "claude":
        for path in session_files(agent, sid, budget)[:1]:
            for line in iter_regular_lines(path, budget, PEEK_FILE_MAX):
                if _blocks_left[0] <= 0:
                    break
                obj = parse_json_dict(line, budget)
                if obj is None:
                    continue
                role = obj.get("type")
                if role not in ("user", "assistant"):
                    continue
                content = as_dict(obj.get("message")).get("content")
                if role == "user":
                    if isinstance(content, str):
                        txt = extract_claude_text(content)
                        if txt:
                            render_block(role, txt)
                    elif isinstance(content, list):
                        for part in content:
                            if isinstance(part, dict) and part.get("type") == "text":
                                txt = extract_claude_text(part.get("text", ""))
                                if txt:
                                    render_block(role, txt)
                else:
                    if isinstance(content, str):
                        if usable_text(content):
                            render_block(role, content)
                    elif isinstance(content, list):
                        for part in content:
                            if isinstance(part, dict) and part.get("type") == "text" \
                                    and usable_text(part.get("text", "")):
                                render_block(role, part["text"])
    elif agent == "codex":
        for path in session_files(agent, sid, budget)[:1]:
            for line in iter_regular_lines(path, budget, PEEK_FILE_MAX):
                if _blocks_left[0] <= 0:
                    break
                obj = parse_json_dict(line, budget)
                if obj is None:
                    continue
                payload = as_dict(obj.get("payload"))
                if obj.get("type") == "event_msg":
                    if payload.get("type") == "user_message" \
                            and usable_text(payload.get("message", "")):
                        render_block("user", payload["message"])
                    elif payload.get("type") == "agent_message" and payload.get("message"):
                        render_block("assistant", payload["message"])
    elif agent == "opencode":
        db = HOME + "/.local/share/opencode/opencode.db"
        con = open_sqlite_readonly(db, budget)
        if con is not None:
            try:
                rows = con.execute(
                    "select m.data, p.data from part p"
                    " join message m on m.id = p.message_id"
                    " where p.session_id = ? and length(m.data) <= ?"
                    " and length(p.data) <= ? order by p.time_created limit 400",
                    (sid, SQLITE_FIELD_MAX, SQLITE_FIELD_MAX))
                for mdata, pdata in rows:
                    if _blocks_left[0] <= 0 or not budget.active():
                        break
                    row_bytes = len(str(mdata).encode("utf-8", errors="replace")) \
                        + len(str(pdata).encode("utf-8", errors="replace"))
                    if budget.read_allowance(row_bytes) < row_bytes:
                        break
                    budget.account(row_bytes)
                    message = parse_json_dict(mdata, budget)
                    part = parse_json_dict(pdata, budget)
                    if message is None or part is None:
                        continue
                    role = message.get("role", "assistant")
                    if part.get("type") == "text" and usable_text(part.get("text", "")):
                        render_block(role, part["text"])
            except sqlite3.Error:
                pass
            finally:
                con.close()
    elif agent == "grok":
        for path in session_files(agent, sid, budget)[:1]:
            for line in iter_regular_lines(path, budget, PEEK_FILE_MAX):
                if _blocks_left[0] <= 0:
                    break
                obj = parse_json_dict(line, budget)
                if obj is None:
                    continue
                role = obj.get("role") or obj.get("type")
                if role not in ("user", "assistant"):
                    continue
                if obj.get("synthetic_reason") == "system_reminder":
                    continue
                content = obj.get("content")
                if role == "user":
                    text = extract_grok_text(content)
                    if text:
                        render_block(role, text)
                else:
                    text = content_text(content)
                    if usable_text(text):
                        render_block(role, text)
    else:
        print("No transcript renderer for " + agent)


def folder(agent, sid):
    s = find(agent, sid)
    if s is None:
        return
    cwd = s["dir"] if os.path.isdir(s["dir"]) else HOME
    spawn(["setsid", "uwsm-app", "--", "xdg-open", cwd])


def copy_id(agent, sid):
    try:
        subprocess.run(["wl-copy", "--", str(sid)], check=False, timeout=2)
    except subprocess.TimeoutExpired:
        pass


def delete(agent, sid):
    if find(agent, sid) is None:
        return
    if agent == "opencode":
        try:
            subprocess.run(["opencode", "session", "delete", str(sid)],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           check=False, timeout=5)
        except subprocess.TimeoutExpired:
            pass
        return
    if agent == "grok":
        root = grok_home()
        budget = ScanBudget(seconds=1.0, max_paths=32, max_open_files=8, max_bytes=1024)
        dirs = bounded_paths([(root + "/sessions/*/" + sid, False)], budget)
        for dir_path, _info in dirs:
            try:
                shutil.rmtree(dir_path)
            except OSError:
                pass
        return
    budget = ScanBudget(seconds=1.0, max_paths=32, max_open_files=8,
                        max_bytes=1024)
    for path in session_files(agent, sid, budget):
        try:
            if stat.S_ISREG(os.lstat(path).st_mode):
                os.remove(path)
        except OSError:
            pass


ACTIONS = {"resume": resume, "peek": peek, "peek-render": peek_render,
           "folder": folder, "copy": copy_id, "delete": delete}

if __name__ == "__main__":
    if len(sys.argv) == 1:
        sys.stdout.write(encode_payload(collect()))
    elif len(sys.argv) >= 4 and sys.argv[1] in ACTIONS and sys.argv[2] in SCANNERS:
        if not valid_id(sys.argv[2], sys.argv[3]):
            sys.exit(2)
        ACTIONS[sys.argv[1]](sys.argv[2], sys.argv[3])
    else:
        sys.exit(2)
