# Collection is intentionally partial under pathological stores. These are
# cumulative process-level ceilings, not merely UI/output checks.
CANDIDATE_CAP = 128
MAX_PATHS = 1024
MAX_OPEN_FILES = 768
MAX_SCAN_BYTES = 64 * 1024 * 1024
SCAN_SECONDS = 4.0
JSON_FILE_MAX = 2 * 1024 * 1024
JSONL_HEAD_MAX = 1024 * 1024
JSON_DEPTH_MAX = 64
METADATA_FILE_MAX = 2 * 1024 * 1024
PEEK_FILE_MAX = 8 * 1024 * 1024
SQLITE_FILE_MAX = 512 * 1024 * 1024
SQLITE_FIELD_MAX = 256 * 1024
OUTPUT_MAX = 900 * 1024
PATH_TEXT_MAX = 1024
META_TEXT_MAX = 256

